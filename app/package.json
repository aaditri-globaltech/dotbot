{
  "name": "dotbot",
  "version": "0.1.5",
  "description": "Electron workspace UI with in-process agent sessions.",
  "homepage": "https://github.com/Aaditri-GlobalTech/dotbot#Dotbot",
  "author": "Kumar Rahul Anand",
  "maintainer": "Aaditri GlobalTech",
  "license": "Apache-2.0",
  "desktopName": "dotbot",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run typecheck && shx rm -rf dist && vite build && esbuild src/main/main.ts --bundle --platform=node --format=esm --external:electron --external:@earendil-works/* --external:@parcel/watcher --outfile=dist/main/main.js && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "release:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "release:windows": "npm run build && electron-builder --win nsis --publish never",
    "release:mac": "npm run build && electron-builder --mac dmg --publish never",
    "start": "electron .",
    "test": "vitest --run --passWithNoTests",
    "check:browser-smoke": "node scripts/check-browser-smoke.mjs",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@dotbot/agent-core": "*",
    "@dotbot/files": "*",
    "@dotbot/git": "*",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vscode/codicons": "0.0.46-24",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "highlight.js": "11.11.1",
    "jsdom": "30.1.1",
    "marked": "16.4.2",
    "mermaid": "11.17.2",
    "shx": "0.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.aaditri.dotbot",
    "productName": "Dotbot",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**/*",
      "node_modules/@parcel/watcher*/**/*"
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "Aaditri GlobalTech",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    }
  }
}
