{
  "name": "dotbot-monorepo",
  "description": "Electron workspace UI with in-process agent sessions.",
  "homepage": "https://github.com/Aaditri-GlobalTech/dotbot#Dotbot",
  "author": "Kumar Rahul Anand",
  "maintainer": "Aaditri GlobalTech",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspace app dev",
    "build": "npm run --workspace app build",
    "start": "npm run --workspace app start",
    "release:linux": "npm run --workspace app release:linux",
    "release:windows": "npm run --workspace app release:windows",
    "check:browser-smoke": "npm run --workspace app check:browser-smoke",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "biome check --write --error-on-warnings app packages package.json tsconfig.base.json biome.json && npm run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "9.1.7",
    "vitest": "4.1.11"
  }
}
